    {
      "id": "Pw4jWiQcbd53tCoV4OHAi",
      "type": "text",
      "x": 2295.9032592279164,
      "y": 1547.3615048646504,
      "width": 567.58349609375,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
