    },
    {
      "id": "21v05eVtdDwoT4UNdXZaX",
      "type": "text",
      "x": -207.71803741266945,
      "y": 1157.500373312952,
      "width": 238.8157958984375,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4T",
