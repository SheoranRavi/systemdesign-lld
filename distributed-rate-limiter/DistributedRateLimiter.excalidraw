      "seed": 1189501785,
      "version": 351,
      "versionNonce": 968312567,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784450306247,
      "link": null,
      "locked": false,
      "text": "Core Entities\n\nRule:\nRefillRate\nMaxTokens\nAPIPath\nRuleBucket\n\nRuleBucket:\nUnAuthed\nAuthorized\nPremium\n\nClient:\nKey (apikey, ipaddress, userId)\nValue\n\nRequest:\nClientId\nTimestamp\nEndpoint",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities\n\nRule:\nRefillRate\nMaxTokens\nAPIPath\nRuleBucket\n\nRuleBucket:\nUnAuthed\nAuthorized\nPremium\n\nClient:\nKey (apikey, ipaddress, userId)\nValue\n\nRequest:\nClientId\nTimestamp\nEndpoint",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
