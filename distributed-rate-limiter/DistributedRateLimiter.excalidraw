      "text": "Rules",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "090irFmVFTxFyv8whrpTF",
      "originalText": "Rules",
      "autoResize": true,
