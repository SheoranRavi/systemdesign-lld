      "isDeleted": true,
      "boundElements": [],
      "updated": 1784109052476,
      "link": null,
      "locked": false,
      "text": "Core Entities\n- Ride\n- Driver\n- Rider\n- Location\n\n\nAPI\n- POST /ride/fare-estimate -> Partial<Ride>\n{ \n    source\n    destination\n}\n\n- PATCH /ride/request -> 200\n{\n    rideId\n}\n\n- POST /location/update\n{\n    lat\n    long\n}\n\n- PATCH /ride/driver/accept\n{\n    rideId\n    isAccepting true/false\n}\n\n- PATCH /ride/driver/update -> lat/long | null (the next location lat/long or null)\n{\n    rideId\n    status: 'pickedup' | 'droppedoff' \n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities\n- Ride\n- Driver\n- Rider\n- Location\n\n\nAPI\n- POST /ride/fare-estimate -> Partial<Ride>\n{ \n    source\n    destination\n}\n\n- PATCH /ride/request -> 200\n{\n    rideId\n}\n\n- POST /location/update\n{\n    lat\n    long\n}\n\n- PATCH /ride/driver/accept\n{\n    rideId\n    isAccepting true/false\n}\n\n- PATCH /ride/driver/update -> lat/long | null (the next location lat/long or null)\n{\n    rideId\n    status: 'pickedup' | 'droppedoff' \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
